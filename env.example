# LLM provider
OPENAI_API_KEY=replace_with_your_key
# Optional: leave blank for the default OpenAI endpoint or set a compatible proxy endpoint.
OPENAI_API_BASE=
LLM_MODEL=gpt-5.5
LLM_REASONING_EFFORT=low

# Siyabonga Technology
COMPANY_NAME=Siyabonga Technology
CEO_NAME=Asher

# Real finance source. Use an existing .xlsx or .xls file; do not point this at a mock file.
FINANCE_EXCEL_PATH=/absolute/path/to/your/financials.xlsx
FINANCE_SHEET_NAME=

# Optional real CRM/Business Development REST endpoint.
# The endpoint must return JSON. Tawanda will receive only the returned data.
CRM_API_URL=
CRM_API_TOKEN=

# Optional real marketing/analytics REST endpoint.
# The endpoint must return JSON. Lucia will receive only the returned data.
MARKETING_API_URL=
MARKETING_API_TOKEN=

# Optional compatible search endpoint. The application sends ?q=<query> and expects JSON.
SEARCH_API_URL=
SEARCH_API_TOKEN=

# Storage
TRANSCRIPT_PATH=logs/boardroom.jsonl
MAX_HISTORY_MESSAGES=80
